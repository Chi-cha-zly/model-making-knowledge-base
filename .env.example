# PostgreSQL + pgvector is required. Start docker compose and migrate first.
DATABASE_URL=postgresql+psycopg://modelkb:modelkb@127.0.0.1:5432/modelkb
DATA_DIR=./data/attachments
BACKUP_MAX_BYTES=104857600

# Model credentials stay server-side. Use API model IDs, not display names.
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-6-luna
AI_COMPARE_MODEL=gpt-6.1-sol
AI_API_KEY=
AI_REASONING_EFFORT=low
AI_MAX_OUTPUT_TOKENS=2048

# LangSmith uses a separate key. Explicit cloud evaluations upload selected data.
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=modelkb-v4
LANGSMITH_WORKSPACE_ID=
# Set true to trace ordinary chat calls too; explicit experiments are separate.
LANGSMITH_TRACING=false

# Explicit embedding CLI only: export these in the process environment.
# scripts.embed_documents never loads .env or falls back to chat credentials.
# Leave empty until a real embedding service/model is selected.
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=

# Independent image interpretation; no automatic chat credential fallback.
VISION_BASE_URL=
VISION_MODEL=
VISION_API_KEY=
# Local-only OCR: vision requires macOS and Swift command line tools.
# Other platforms must explicitly choose tesseract; there is no silent fallback.
OCR_ENGINE=vision
# Used only with OCR_ENGINE=tesseract (chi_sim.traineddata and eng.traineddata).
OCR_TESSDATA_DIR=

# Queries remain local by default; hybrid sends bounded query text to the embedding endpoint.
# rerank = hybrid recall + cross-encoder rerank; it also sends candidate excerpts to RERANK_BASE_URL.
RETRIEVAL_MODE=lexical

# rag = retrieve once then answer (default); agent = tool-calling main agent + research sub-agent.
# Agent mode makes several model and retrieval calls per question (about 20 s, higher cost).
CHAT_MODE=rag

# Independent reranker; no fallback to embedding or chat credentials.
RERANK_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
RERANK_MODEL=qwen3-rerank
RERANK_API_KEY=
# Candidates below this score are dropped; an empty result means "no evidence".
# Calibrated on a local labelled set; re-check after the library grows.
RERANK_MIN_SCORE=0
RERANK_CANDIDATES=20
